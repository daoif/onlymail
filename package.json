{
  "name": "mails",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "init": "npx tsx scripts/init.ts",
    "render:wrangler": "npx tsx scripts/render-wrangler.ts",
    "setup:github": "npx tsx scripts/setup-github.ts",
    "sync:dev-vars": "tsx scripts/sync-dev-vars.ts",
    "deploy:worker": "tsx scripts/deploy-worker.ts",
    "deploy:frontend": "tsx scripts/deploy-frontend.ts",
    "build": "pnpm --dir worker run build && pnpm --dir frontend run build && pnpm --dir sdk/nodejs run build",
    "build:worker": "pnpm --dir worker run build",
    "build:frontend": "pnpm --dir frontend run build",
    "build:sdk:node": "pnpm --dir sdk/nodejs run build",
    "check:python": "python -m compileall sdk/python"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0"
  }
}
