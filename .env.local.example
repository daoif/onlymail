# ═══════════════════════════════════════
# 第一批先填：Cloudflare 必填 4 项
# 正常可用部署默认就按这 4 个值准备
# ═══════════════════════════════════════

# Cloudflare API Token（在 CF 控制台 → Profile → API Tokens 创建）
# 权限需要：Workers Scripts Edit, D1 Edit, Pages Edit, DNS Edit, Zone Read
CF_API_TOKEN=

# Cloudflare Account ID（CF 控制台 → 点进任意已托管域名 → 右下角 API 区域）
CF_ACCOUNT_ID=

# Cloudflare 账号邮箱（Cloudflare 控制台账号邮箱）
# 当前项目的根域名 bootstrap、子域名创建/删除、catch-all 和 Email Routing 规则操作都依赖它
CF_EMAIL=

# Cloudflare Global API Key（Profile → API Tokens / Global API Key）
# Cloudflare API Token 当前不能覆盖 Email Routing 这组接口，所以这里是主鉴权
CF_GLOBAL_API_KEY=

# ═══════════════════════════════════════
# 自动回写：系统内部状态
# 不用手动填；init / rebuild / setup:github 会自己维护
# ═══════════════════════════════════════

# D1 数据库 ID（首次 init 会自动创建并回写）
D1_DATABASE_ID=
