# ═══════════════════════════════════════
# 第一批先填：Cloudflare 必填 4 项
# 正常可用部署默认就按这 4 个值准备
# ═══════════════════════════════════════

# Cloudflare API Token（在 CF 控制台 → Profile → API Tokens 创建）
# 权限需要：Workers Scripts Edit, D1 Edit, Pages Edit, DNS Edit, Zone Read
CF_API_TOKEN=

# Cloudflare Account ID（CF 控制台 → 点进任意已托管域名 → 右下角 API 区域）
CF_ACCOUNT_ID=

# Cloudflare 账号邮箱（Cloudflare 控制台账号邮箱）
# 当前项目的根域名 bootstrap、子域名创建/删除、catch-all 和 Email Routing 规则操作都依赖它
CF_EMAIL=

# Cloudflare Global API Key（Profile → API Tokens / Global API Key）
# Cloudflare API Token 当前不能覆盖 Email Routing 这组接口，所以这里是主鉴权
CF_GLOBAL_API_KEY=

# ═══════════════════════════════════════
# 其他可选：部署默认值
# 不填就使用系统默认值
# ═══════════════════════════════════════

# D1 数据库 ID（首次 init 会自动创建并回写；如果手动渲染 wrangler.toml 则必填）
D1_DATABASE_ID=

# Worker 和 Pages 项目名（不填则分别使用 mails-worker 和 mails-frontend）
CF_DEFAULT_WORKER_NAME=mails-worker
CF_DEFAULT_PAGES_PROJECT=mails-frontend

# ═══════════════════════════════════════
# 高级可选：额外浏览器来源
# ═══════════════════════════════════════

# CORS 白名单基础值，给“其他前端站点在浏览器里直接请求本 Worker API”时用
# 通常留空，让 init / setup:github 只按 pages.dev + localhost 自动推导
# 已经绑在 Cloudflare 上、但没写进 D1 的自定义域名不会被默认接管
# 格式是逗号分隔的 origin 字符串，不是数组；每项只写 协议://域名[:端口]，不要带路径
# 例如：ALLOWED_ORIGINS=https://admin.example.com,https://ops.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# ═══════════════════════════════════════
# 运行时 Secret（init 会自动生成，一般不用手动填）
# ═══════════════════════════════════════

# JWT 签名密钥（init 自动生成并回写，只在需要手动覆盖时填）
# JWT_SECRET=
