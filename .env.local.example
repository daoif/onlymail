# ═══════════════════════════════════════
# Cloudflare 凭证（本地部署必填）
# ═══════════════════════════════════════

# Cloudflare API Token（在 CF 控制台 → Profile → API Tokens 创建）
# 权限需要：Workers Scripts Edit, D1 Edit, Pages Edit, DNS Edit, Zone Read
CF_API_TOKEN=

# Cloudflare Account ID（CF 控制台 → 点进任意已托管域名 → 右下角 API 区域）
CF_ACCOUNT_ID=

# 默认 Zone ID（CF 控制台 → 点进任意已托管域名 → 右下角 API 区域）
# 现在不是本地部署和本地开发的硬必填；只在你想让 init 顺手自动配置某个 Zone 的 Email Routing，或要给 GitHub workflow 写默认 Zone 变量时再填
CF_DEFAULT_ZONE_ID=

# ═══════════════════════════════════════
# Cloudflare 域名与 Email Routing 自动化建议提供
# ═══════════════════════════════════════

# 做根域名 bootstrap、子域名创建、Email Routing 自动化时建议提供
# 不提供时，Worker / Pages / D1 初始化还能继续，但 Email Routing 相关动作要手动去 CF 控制台完成
CF_EMAIL=
# 做根域名 bootstrap、子域名创建、Email Routing 自动化时建议提供
# 不提供时，Worker / Pages / D1 初始化还能继续，但 Email Routing 相关动作要手动去 CF 控制台完成
CF_GLOBAL_API_KEY=

# D1 数据库 ID（首次 init 会自动创建并回写；如果手动渲染 wrangler.toml 则必填）
D1_DATABASE_ID=

# Worker 和 Pages 项目名（有默认值，不填则分别使用 mails-worker 和 mails-frontend）
CF_DEFAULT_WORKER_NAME=mails-worker
CF_DEFAULT_PAGES_PROJECT=mails-frontend

# ═══════════════════════════════════════
# 本地开发高级可选
# ═══════════════════════════════════════

# CORS 白名单，通常留空让 init 自动推导
ALLOWED_ORIGINS=

# 前端请求后端的地址，通常留空让 init 自动推导
VITE_API_BASE_URL=

# ═══════════════════════════════════════
# GitHub 可选（本地部署不需要）
# ═══════════════════════════════════════

# 仓库全名（如 yourname/mails），配合 gh CLI 自动写 GitHub Secrets
GITHUB_REPOSITORY=

# ═══════════════════════════════════════
# 运行时 Secret（init 会自动生成，一般不用手动填）
# ═══════════════════════════════════════

# JWT 签名密钥（init 自动生成并回写，只在需要手动覆盖时填）
# JWT_SECRET=
