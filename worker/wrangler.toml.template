# 本文件是 wrangler.toml 的模板，不包含敏感信息
# 复制为 wrangler.toml 后填入实际值

name = "onlymail-worker"
main = "src/worker.ts"
compatibility_date = "2026-03-28"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true
head_sampling_rate = 1

[triggers]
crons = ["0 * * * *"]

[vars]
CF_ACCOUNT_ID = "__ACCOUNT_ID__"

[[d1_databases]]
binding = "DB"
database_name = "onlymail-db"
database_id = "__DATABASE_ID__"
