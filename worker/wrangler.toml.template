# 本文件是 wrangler.toml 的模板，不包含敏感信息
# 复制为 wrangler.toml 后填入实际值

name = "mails-worker"
main = "src/worker.ts"
compatibility_date = "2026-03-28"
compatibility_flags = ["nodejs_compat"]

[triggers]
crons = ["0 * * * *"]

[vars]
CF_DEFAULT_ZONE_ID = "__ZONE_ID__"
CF_DEFAULT_WORKER_NAME = "mails-worker"
CF_ACCOUNT_ID = "__ACCOUNT_ID__"
CF_DEFAULT_PAGES_PROJECT = "__PAGES_PROJECT_NAME__"
# ALLOWED_ORIGINS = "https://mails.你的域名,http://localhost:5173"

[[d1_databases]]
binding = "DB"
database_name = "mails-db"
database_id = "__DATABASE_ID__"
